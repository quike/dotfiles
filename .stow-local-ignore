# GNU Stow ignore list for this package.
#
# Patterns without a "/" match the basename, anchored as ^(pattern)$.
# Patterns with a "/" match the path, anchored as (^|/)(pattern)(/|$),
# so "^/name" pins an entry to the repository root.
#
# This file replaces Stow's built-in default ignore list, so the VCS and
# editor-cruft defaults have to be repeated here.

# Version control
RCS
CVS
_darcs
\.git
\.gitignore
\.gitmodules
\.gitattributes
\.github
\.hg
\.svn
\.cvsignore
\.\#.+
.+,v

# Editor and OS cruft
.+~
\#.*\#
\.DS_Store
\.idea
\.claude

# Repository tooling: belongs in the repo, never in $HOME
\.editorconfig
\.releaserc
\.stowrc
^/docs
^/renovate\.json
^/setup\.sh
^/README.*
^/LICENSE.*
^/COPYING
